# ============================================================
# Popas pentru Suflet — .gitignore la rădăcină
# ============================================================

# --- Dependente ---
node_modules/
.next/
out/
dist/
build/

# --- Mediu / secrete ---
.env
.env.local
.env.*.local
*.pem
*.key

# --- Loguri ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Sistem de operare ---
.DS_Store
Thumbs.db

# --- Editor ---
.vscode/
.idea/
*.swp
*.swo

# --- MongoDB (date locale + binare) ---
bin/
*.pdb
*.exe
data/*.wt
data/*.bson
data/journal/
data/WiredTiger*


# --- Uploaduri generate ---
uploads/
backend/uploads/

# --- Android / TWA ---
*.keystore
*.jks
*.apk
*.aab
*.idsig
.gradle/
.kotlin/
local.properties
twa/app/build/
twa/build/
twa/app/.gradle/
twa/.gradle/

# --- Diverse ---
coverage/
*.tsbuildinfo
next-env.d.ts

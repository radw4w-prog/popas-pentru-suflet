# ═══════════════════════════════════════
# AI PROVIDERS — Multi-provider setup
# ═══════════════════════════════════════

# OpenRouter (PRINCIPAL) — 15+ modele free cu o cheie
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx

# Mistral AI — Cea mai bună calitate pentru română
MISTRAL_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Cerebras — Cel mai rapid (1M tokens/zi gratis)
CEREBRAS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face — Model românesc RoLlama3
HF_API_KEY=hf_xxxxxxxxxxxxxxxxxxxxxxxx

# Groq (deja îl ai)
GROQ_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# Gemini (deja îl ai)
GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxx

# ═══════════════════════════════════════
# APP
# ═══════════════════════════════════════
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/popas_suflet
JWT_SECRET=your-super-secret-jwt-key-change-this

# Web Push / VAPID
VAPID_SUBJECT=mailto:contact@popas-pentru-suflet.ro
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
ENABLE_SCHEDULER=false

# ═══════════════════════════════════════
# EMAIL (nodemailer + SMTP)
# ═══════════════════════════════════════
# Furnizori gratui recomandați: Brevo (smtp-relay.brevo.com:587),
# SendGrid (smtp.sendgrid.net:587), Resend (smtp.resend.com:587)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your-smtp-login
SMTP_PASS=your-smtp-key
SMTP_FROM=Popas pentru Suflet <noreply@popas-pentru-suflet.vercel.app>
FRONTEND_URL=https://popas-pentru-suflet.vercel.app